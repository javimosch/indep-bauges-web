<!DOCTYPE html>
<html lang="fr" data-theme="bauges" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}} - {{site.name}}</title>
  <meta name="description" content="{{description}}">
  {{#if keywords}}
  <meta name="keywords" content="{{join keywords ', '}}">
  {{/if}}
  
  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="{{currentUrl}}">
  <meta property="og:title" content="{{title}} - {{site.name}}">
  <meta property="og:description" content="{{description}}">
  {{#if page.meta.ogImage}}
  <meta property="og:image" content="{{page.meta.ogImage}}">
  {{/if}}
  
  {{> head-styles}}
  
  {{#if customCSS}}
  <style>{{{customCSS}}}</style>
  {{/if}}
</head>
<body class="bg-bauges-light text-bauges-dark">
  {{> header}}
  
  <!-- Full-width main content without container -->
  <main class="min-h-screen">
    {{{body}}}
  </main>
  
  {{> footer}}
  {{> admin-scripts}}
  
  {{#if customJS}}
  <script>{{{customJS}}}</script>
  {{/if}}
</body>
</html>