<section class="py-20 bg-bauges-light">
  <div class="container mx-auto px-4">
    <div class="max-w-6xl mx-auto">
      <header class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-bold font-display text-bauges-primary mb-4" data-id="page-title-{{page._id}}">
          {{title}}
        </h1>
        {{#if description}}
        <p class="text-xl text-bauges-dark/80 max-w-2xl mx-auto" data-id="page-description-{{page._id}}">
          {{description}}
        </p>
        {{/if}}
      </header>
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <!-- Content -->
        <div class="prose prose-lg">
          <div class="bg-white rounded-xl shadow-lg p-8" data-id="page-content-{{page._id}}">
            {{{content}}}
          </div>
        </div>
        
        <!-- Contact Form -->
        <div class="bg-white rounded-xl shadow-lg p-8">
          <h2 class="text-2xl font-bold font-display text-bauges-primary mb-6">Nous contacter</h2>
          <form class="space-y-6">
            <div>
              <label for="name" class="block text-sm font-medium text-bauges-dark mb-2">Nom</label>
              <input type="text" id="name" name="name" required 
                     class="w-full px-4 py-2 border border-bauges-secondary/30 rounded-lg focus:ring-2 focus:ring-bauges-primary focus:border-transparent">
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-bauges-dark mb-2">Email</label>
              <input type="email" id="email" name="email" required 
                     class="w-full px-4 py-2 border border-bauges-secondary/30 rounded-lg focus:ring-2 focus:ring-bauges-primary focus:border-transparent">
            </div>
            <div>
              <label for="subject" class="block text-sm font-medium text-bauges-dark mb-2">Sujet</label>
              <input type="text" id="subject" name="subject" required 
                     class="w-full px-4 py-2 border border-bauges-secondary/30 rounded-lg focus:ring-2 focus:ring-bauges-primary focus:border-transparent">
            </div>
            <div>
              <label for="message" class="block text-sm font-medium text-bauges-dark mb-2">Message</label>
              <textarea id="message" name="message" rows="5" required 
                        class="w-full px-4 py-2 border border-bauges-secondary/30 rounded-lg focus:ring-2 focus:ring-bauges-primary focus:border-transparent"></textarea>
            </div>
            <button type="submit" 
                    class="w-full btn btn-primary text-white py-3">
              <i class="fas fa-paper-plane mr-2"></i>Envoyer le message
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>