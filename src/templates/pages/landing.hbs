<!-- Hero Section -->
<section class="min-h-screen bg-mountain flex items-center justify-center text-white">
  <div class="container mx-auto px-4 text-center">
    <h1 class="text-5xl md:text-7xl font-bold font-display mb-6 text-shadow" data-id="page-title-{{page._id}}">
      {{title}}
    </h1>
    {{#if description}}
    <p class="text-xl md:text-2xl mb-8 max-w-3xl mx-auto text-shadow" data-id="page-description-{{page._id}}">
      {{description}}
    </p>
    {{/if}}
    
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a href="#content" class="btn btn-primary btn-lg text-white">
        <i class="fas fa-arrow-down mr-2"></i>Découvrir
      </a>
      <a href="/#contact" class="btn btn-outline btn-lg text-white border-white hover:bg-white hover:text-bauges-primary">
        <i class="fas fa-envelope mr-2"></i>Nous contacter
      </a>
    </div>
  </div>
</section>

<!-- Content Section -->
<section id="content" class="py-20 bg-bauges-light">
  <div class="container mx-auto px-4">
    <div class="max-w-4xl mx-auto">
      <article class="prose prose-lg max-w-none">
        <div class="bg-white rounded-xl shadow-lg p-8" data-id="page-content-{{page._id}}">
          {{{content}}}
        </div>
      </article>
    </div>
  </div>
</section>