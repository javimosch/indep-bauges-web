<section class="py-20 bg-bauges-light">
  <div class="container mx-auto px-4">
    <div class="max-w-4xl mx-auto">
      <header class="text-center mb-12">
        <h1 class="text-4xl md:text-5xl font-bold font-display text-bauges-primary mb-4" data-id="page-title-{{page._id}}">
          {{title}}
        </h1>
        {{#if description}}
        <p class="text-xl text-bauges-dark/80 max-w-2xl mx-auto" data-id="page-description-{{page._id}}">
          {{description}}
        </p>
        {{/if}}
      </header>
      
      <article class="prose prose-lg max-w-none">
        <div class="bg-white rounded-xl shadow-lg p-8" data-id="page-content-{{page._id}}">
          {{{content}}}
        </div>
      </article>
      
      {{#if page.updatedAt}}
      <footer class="text-center mt-8 text-sm text-bauges-dark/60">
        Dernière mise à jour : {{formatDate page.updatedAt}}
      </footer>
      {{/if}}
    </div>
  </div>
</section>